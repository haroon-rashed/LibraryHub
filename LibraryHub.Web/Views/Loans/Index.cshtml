@using LibraryHub.Common.Enums
@model LoanListViewModel
@{
    ViewData["Title"] = "Loans";

    var filters = new[]
    {
        (Value: "all", Label: "All"),
        (Value: "active", Label: "Active"),
        (Value: "overdue", Label: "Overdue")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Loans</h1>
    <a asp-action="Create" class="btn btn-primary">Borrow a book</a>
</div>

<ul class="nav nav-pills mb-3">
    @foreach (var filter in filters)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Status == filter.Value ? "active" : "")"
               asp-action="Index" asp-route-status="@filter.Value">@filter.Label</a>
        </li>
    }
</ul>

@if (!Model.Loans.Any())
{
    <div class="alert alert-info">No loans found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Book</th>
                <th>Member</th>
                <th>Borrowed</th>
                <th>Due</th>
                <th>Returned</th>
                <th>Late fee</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Loans)
            {
                var badge = loan.Status switch
                {
                    LoanStatus.Overdue => "danger",
                    LoanStatus.Returned => "secondary",
                    _ => "info"
                };

                <tr>
                    <td>@loan.BookTitle</td>
                    <td>@loan.MemberName</td>
                    <td>@loan.BorrowedOn.ToString("dd MMM yyyy")</td>
                    <td>@loan.DueOn.ToString("dd MMM yyyy")</td>
                    <td>@(loan.ReturnedOn?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td>@(loan.ReturnedOn == null ? "-" : loan.LateFee.ToString("0.##"))</td>
                    <td><span class="badge text-bg-@badge">@loan.Status</span></td>
                    <td class="text-end">
                        @if (loan.ReturnedOn == null)
                        {
                            <form asp-action="Return" asp-route-id="@loan.Id" asp-route-status="@Model.Status" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Return</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}