@model BookListViewModel
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Books</h1>
    <a asp-action="Create" class="btn btn-primary">Add book</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by title or author" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

@if (!Model.Result.Items.Any())
{
    <div class="alert alert-info">No books found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>ISBN</th>
                <th>Year</th>
                <th>Available / Total</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Result.Items)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Isbn</td>
                    <td>@book.PublishedYear</td>
                    <td>@book.AvailableCopies / @book.TotalCopies</td>
                    <td class="text-end">
                        @if (book.AvailableCopies > 0)
                        {
                            <a asp-controller="Loans" asp-action="Create" asp-route-bookId="@book.Id" class="btn btn-sm btn-success">Borrow</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-success" disabled>Borrow</button>
                        }
                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this book?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Pager" model="new PagerViewModel { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages, Search = Model.Search }" />
}   