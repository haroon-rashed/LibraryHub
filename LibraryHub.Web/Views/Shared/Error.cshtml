@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-6">Something went wrong</h1>
    <p class="lead text-muted">
        We could not reach the library service or it returned an unexpected error.
        Please make sure the API is running and try again.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to dashboard</a>
</div>